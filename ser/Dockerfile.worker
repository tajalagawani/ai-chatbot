FROM python:3.9-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy application files
COPY worker.py /app/
COPY act_executor.py /app/
COPY requirements.worker.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary directories
RUN mkdir -p /app/tmp

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV OPENAI_API_KEY=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

# Fix the CMD syntax - remove the brackets
CMD ["python", "worker.py"]